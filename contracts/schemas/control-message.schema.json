{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ya-labs/LoL-Remote/contracts/schemas/control-message.schema.json",
  "title": "Mensagem de controle do LoL Remote",
  "description": "Mensagens trocadas no canal de dados WebRTC \"control\" (ordenado e confiável). Versão 1. Implementação de referência: src/LoLRemote.Agent.Core/Protocol.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": { "enum": ["input.tap", "input.ack", "state"] }
  },
  "oneOf": [
    { "$ref": "#/$defs/tap" },
    { "$ref": "#/$defs/ack" },
    { "$ref": "#/$defs/state" }
  ],
  "$defs": {
    "version": {
      "description": "Versão do protocolo.",
      "const": 1
    },
    "sequence": {
      "description": "Número de sequência, estritamente crescente por sessão. Sequências repetidas ou menores são recusadas.",
      "type": "integer",
      "minimum": 0
    },
    "coordinate": {
      "description": "Coordenada normalizada sobre o vídeo recebido (0 = esquerda/topo, 1 = direita/base).",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rejectReason": {
      "description": "Motivo de recusa ou bloqueio de input.",
      "enum": [
        "unsupported-version",
        "out-of-order",
        "expired",
        "from-future",
        "rate-limited",
        "invalid-coordinates",
        "letterbox",
        "outside-client-area",
        "target-unavailable",
        "target-minimized",
        "target-obscured",
        "capture-stale",
        "phase-unknown",
        "phase-blocked",
        "local-activity",
        "remote-mode-inactive"
      ]
    },
    "phase": {
      "description": "Fase de gameflow do League Client, com os nomes da LCU.",
      "enum": [
        "Unknown", "None", "Lobby", "Matchmaking", "ReadyCheck", "ChampSelect",
        "GameStart", "InProgress", "Reconnect", "WaitingForStats", "PreEndOfGame", "EndOfGame"
      ]
    },
    "tap": {
      "title": "input.tap (celular → agente)",
      "description": "Toque explícito da pessoa em um ponto do vídeo. O agente responde sempre com input.ack.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "v", "seq", "sentAt", "x", "y"],
      "properties": {
        "type": { "const": "input.tap" },
        "v": { "$ref": "#/$defs/version" },
        "seq": { "$ref": "#/$defs/sequence" },
        "sentAt": {
          "description": "Horário de envio no relógio do agente, em ms (o celular sincroniza por GET /api/v1/time). Comandos com mais de 1000 ms são recusados.",
          "type": "integer"
        },
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" }
      }
    },
    "ack": {
      "title": "input.ack (agente → celular)",
      "description": "Confirmação explícita de um comando.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "v", "seq", "status"],
      "properties": {
        "type": { "const": "input.ack" },
        "v": { "$ref": "#/$defs/version" },
        "seq": { "$ref": "#/$defs/sequence" },
        "status": { "enum": ["accepted", "rejected"] },
        "reason": { "$ref": "#/$defs/rejectReason" }
      },
      "if": { "properties": { "status": { "const": "rejected" } } },
      "then": { "required": ["reason"] },
      "else": { "not": { "required": ["reason"] } }
    },
    "state": {
      "title": "state (agente → celular)",
      "description": "Estado atual e se o input está liberado. Enviado ao conectar e a cada mudança.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "v", "phase", "inputAllowed"],
      "properties": {
        "type": { "const": "state" },
        "v": { "$ref": "#/$defs/version" },
        "phase": { "$ref": "#/$defs/phase" },
        "inputAllowed": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/rejectReason" }
      },
      "if": { "properties": { "inputAllowed": { "const": false } } },
      "then": { "required": ["reason"] },
      "else": { "not": { "required": ["reason"] } }
    }
  }
}
