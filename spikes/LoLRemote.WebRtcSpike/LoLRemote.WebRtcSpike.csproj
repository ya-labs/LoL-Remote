<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Spike: transmite a janela do simulador para o Safari do iPhone por WebRTC
    com H.264. Código descartável; resultado em docs/spike-webrtc.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>LoLRemote.WebRtcSpike</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Alertas de vulnerabilidade de dependências aparecem, mas não quebram o build do spike. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="10.0.16" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Reaproveita a localização e a captura de janela do spike anterior. -->
  <ItemGroup>
    <Compile Include="..\LoLRemote.CaptureSpike\NativeMethods.cs" Link="Shared\NativeMethods.cs" />
    <Compile Include="..\LoLRemote.CaptureSpike\TargetWindow.cs" Link="Shared\TargetWindow.cs" />
    <Compile Include="..\LoLRemote.CaptureSpike\CaptureInterop.cs" Link="Shared\CaptureInterop.cs" />
  </ItemGroup>

</Project>
