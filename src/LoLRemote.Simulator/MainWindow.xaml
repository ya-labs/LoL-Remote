<Window x:Class="LoLRemote.Simulator.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoL Remote Simulator"
        Width="1000"
        Height="600"
        MinWidth="480"
        MinHeight="300"
        Background="Black"
        WindowStartupLocation="CenterScreen">
  <!--
    O Viewbox escala o espaço de referência 1280x720 com Stretch=Uniform.
    As faixas pretas (letterbox) aparecem quando a proporção da janela não é 16:9.
  -->
  <Viewbox Stretch="Uniform">
    <Grid Width="1280" Height="720" ClipToBounds="True">
      <Canvas x:Name="Screen" Background="#010A13" />
      <Canvas x:Name="Overlay" IsHitTestVisible="False" />
    </Grid>
  </Viewbox>
</Window>
