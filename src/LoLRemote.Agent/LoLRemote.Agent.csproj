<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Agente desktop: captura a janela alvo, envia o vídeo por WebRTC e converte
    toques validados em cliques. Na v0.1 aceita somente o simulador como alvo.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>LoLRemote.Agent</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Alertas de vulnerabilidade de dependências aparecem, mas não quebram o build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="10.0.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoLRemote.Agent.Core\LoLRemote.Agent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
